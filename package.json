{
  "name": "@devandtravel/flow",
  "version": "0.1.0",
  "description": "Tool-first multi-agent runtime platform for deterministic task execution.",
  "license": "MIT",
  "type": "commonjs",
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "agent": "dist/packages/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docker",
